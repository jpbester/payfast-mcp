{
  "name": "payfast-mcp",
  "version": "1.0.1",
  "description": "Model Context Protocol (MCP) server for PayFast — enables AI assistants to interact with South Africa's leading payment gateway",
  "mcpName": "io.github.jpbester/payfast",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "payfast-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node --esm src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "payfast",
    "mcp",
    "model-context-protocol",
    "ai",
    "payment",
    "south-africa",
    "claude",
    "llm",
    "fintech"
  ],
  "author": "JP Bester",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpbester/payfast-mcp.git"
  },
  "homepage": "https://github.com/jpbester/payfast-mcp#readme",
  "bugs": {
    "url": "https://github.com/jpbester/payfast-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "license": "MIT"
}
